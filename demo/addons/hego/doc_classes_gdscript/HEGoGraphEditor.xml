<?xml version='1.0' encoding='utf-8'?>
<class xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="HEGoGraphEditor" inherits="RefCounted" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
	<brief_description>
		Viewport editing for a selected [HEGoGraphInput3D].
	</brief_description>
	<description>
		Point selection and the move/rotate/scale widget are Godot's built-in subgizmos. This object only handles Draw-mode clicks, connection picks, empty clicks that clear the selection, the right-click menu, and the attribute strip.
	</description>
