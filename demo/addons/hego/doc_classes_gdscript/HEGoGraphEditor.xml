		<method name="group_points">
			<return type="PackedInt32Array" />
			<description>
				Points the group widget moves: the selected points plus both ends of every selected connection.
			</description>
		</method>
		<method name="group_center">
			<return type="Vector3" />
			<description>
				Local-space centre of [method group_points].
			</description>
		</method>
		<method name="move_group_live">
			<return type="void" />
			<param index="0" name="center" type="Vector3" />
			<description>
				Moves the group so its centre sits at [param center]. Offsets are taken from where the points were when the drag began, so a point shared by two selected connections moves once.
			</description>
		</method>
		<method name="take_group_start">
			<return type="Dictionary" />
			<description>
				Ends a group drag. Returns the positions from before it, keyed by point.
