// Generated constant-index descriptor dispatch for Godot 4.4.1.
// Sampler arrays are individually bound Texture2D resources. No nonuniform
// descriptor indexing is required. Derivatives are provided by the caller.
vec4 terrain_color_grad(int id, vec2 uv, vec2 dx, vec2 dy) {
	switch (id) {
		case 0: return textureGrad(color_maps[0], uv, dx, dy);
		case 1: return textureGrad(color_maps[1], uv, dx, dy);
		case 2: return textureGrad(color_maps[2], uv, dx, dy);
		case 3: return textureGrad(color_maps[3], uv, dx, dy);
		case 4: return textureGrad(color_maps[4], uv, dx, dy);
		case 5: return textureGrad(color_maps[5], uv, dx, dy);
		case 6: return textureGrad(color_maps[6], uv, dx, dy);
		case 7: return textureGrad(color_maps[7], uv, dx, dy);
		case 8: return textureGrad(color_maps[8], uv, dx, dy);
		case 9: return textureGrad(color_maps[9], uv, dx, dy);
		case 10: return textureGrad(color_maps[10], uv, dx, dy);
		case 11: return textureGrad(color_maps[11], uv, dx, dy);
		case 12: return textureGrad(color_maps[12], uv, dx, dy);
		case 13: return textureGrad(color_maps[13], uv, dx, dy);
		case 14: return textureGrad(color_maps[14], uv, dx, dy);
		case 15: return textureGrad(color_maps[15], uv, dx, dy);
		case 16: return textureGrad(color_maps[16], uv, dx, dy);
		case 17: return textureGrad(color_maps[17], uv, dx, dy);
		case 18: return textureGrad(color_maps[18], uv, dx, dy);
		case 19: return textureGrad(color_maps[19], uv, dx, dy);
		case 20: return textureGrad(color_maps[20], uv, dx, dy);
		case 21: return textureGrad(color_maps[21], uv, dx, dy);
		case 22: return textureGrad(color_maps[22], uv, dx, dy);
		case 23: return textureGrad(color_maps[23], uv, dx, dy);
		case 24: return textureGrad(color_maps[24], uv, dx, dy);
		case 25: return textureGrad(color_maps[25], uv, dx, dy);
		case 26: return textureGrad(color_maps[26], uv, dx, dy);
		case 27: return textureGrad(color_maps[27], uv, dx, dy);
		case 28: return textureGrad(color_maps[28], uv, dx, dy);
		case 29: return textureGrad(color_maps[29], uv, dx, dy);
		case 30: return textureGrad(color_maps[30], uv, dx, dy);
		case 31: return textureGrad(color_maps[31], uv, dx, dy);
	}
	return textureGrad(color_maps[0], uv, dx, dy);
}
