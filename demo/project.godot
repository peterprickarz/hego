config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Demo"
run/main_scene="res://scenes/terrain_island.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

MCPGameBridge="res://addons/godot_mcp/game_bridge/mcp_game_bridge.gd"

[dotnet]

project/assembly_name="Demo"

[editor_plugins]

enabled=PackedStringArray("res://addons/hego/plugin.cfg", "res://addons/strata/plugin.cfg", "res://addons/hego_strata/plugin.cfg", "res://addons/terrain_3d/plugin.cfg", "res://addons/hego_terrain3d/plugin.cfg", "res://addons/godot_mcp/plugin.cfg")

[godot_mcp]

bind_mode=0
custom_bind_ip=""
port_override_enabled=true
